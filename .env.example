# Travel Agent V2 server runtime
# Copy only the settings you need into the ignored env_travel.local file.
# Keep server credentials and Provider keys server-side. Never expose them
# through VITE_* variables. The browser-visible AMap Web JS key is the one
# documented exception below; its paired security code remains server-side.

NODE_ENV=development
PORT=8797

# Local sign-in only. Set true for local development; keep false in production.
TRAVEL_AGENT_ALLOW_DEVELOPMENT_AUTH=false
TRAVEL_AGENT_DATA_DIR=runtime-data/trips
TRAVEL_AGENT_CORS_ORIGINS=http://127.0.0.1:5173

# Production account and OAuth configuration. Use a stable HTTPS origin in production.
# Generate independent random secrets with at least 32 characters; never reuse Provider client secrets.
TRAVEL_AGENT_PUBLIC_ORIGIN=
TRAVEL_AGENT_SESSION_SECRET=
TRAVEL_AGENT_AUTH_STATE_SECRET=
TRAVEL_AGENT_DESKTOP_AUTH_ENABLED=false
TRAVEL_AGENT_DESKTOP_DEEP_LINK_SCHEME=zhuanshu-travel
TRAVEL_AGENT_DESKTOP_API_ORIGIN=

# Primary Web login: Google OpenID Connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRAVEL_AGENT_GOOGLE_AUTH_SMOKE_STATUS=not_run

# WeChat Website Application QR login and native Mini Program code exchange.
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
TRAVEL_AGENT_WECHAT_WEB_AUTH_SMOKE_STATUS=not_run
TRAVEL_AGENT_WECHAT_MINIAPP_AUTH_SMOKE_STATUS=not_run

# Alipay Web login. Keep RSA key files outside the repository with mode 0600.
ALIPAY_WEB_APP_ID=
ALIPAY_WEB_PRIVATE_KEY_PATH=
ALIPAY_WEB_PUBLIC_KEY_PATH=
TRAVEL_AGENT_ALIPAY_WEB_AUTH_SMOKE_STATUS=not_run

# Alipay Mini Program login. It may use a separate AppID and key pair.
ALIPAY_MINIAPP_APP_ID=
ALIPAY_MINIAPP_PRIVATE_KEY_PATH=
ALIPAY_MINIAPP_PUBLIC_KEY_PATH=
TRAVEL_AGENT_ALIPAY_MINIAPP_AUTH_SMOKE_STATUS=not_run

# Sign in with Apple Web. APPLE_CLIENT_ID is the Services ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
TRAVEL_AGENT_APPLE_AUTH_SMOKE_STATUS=not_run

# Production persistence. Leave blank for the local file repository.
DATABASE_URL=

# Parent Agent reasoning
# Official endpoint is pinned by the Pi provider: https://api.deepseek.com
TRAVEL_AGENT_MODEL_PROVIDER=deepseek
TRAVEL_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
TRAVEL_AGENT_DEEPSEEK_SMOKE_STATUS=not_run
TRAVEL_AGENT_DEEPSEEK_VISION_SMOKE_STATUS=not_run

# Native multimodal Parent Agent turn. The image and the user's words enter one
# bounded Agent turn, where the vision model may call the same travel tools.
TRAVEL_AGENT_VISION_PROVIDER=deepseek
TRAVEL_AGENT_VISION_MODEL=deepseek-v4-flash-vision-exp

# Optional Kimi China fallback route and Pi sub-agent credential. To use Kimi
# for visual turns instead, set the two TRAVEL_AGENT_VISION_* values above to
# moonshotai-cn and kimi-k2.6. The endpoint is https://api.moonshot.cn/v1.
MOONSHOT_API_KEY=
TRAVEL_AGENT_KIMI_SMOKE_STATUS=not_run
TRAVEL_AGENT_KIMI_CHILD_SMOKE_STATUS=not_run
TRAVEL_AGENT_ANALYSIS_CHILD_CONCURRENCY=2
# Use postgres_run with DATABASE_URL for multiple API/Worker processes.
# single_process is only the local development mode.
TRAVEL_AGENT_WORKFLOW_EXECUTION_MODE=single_process
TRAVEL_AGENT_INSTANCE_COUNT=1
TRAVEL_AGENT_WORKFLOW_COORDINATOR=

# Server-side typed decision model. Never put this key in VITE_* or a client.
# off: existing Parent/Child path; shadow: record Jev alongside the existing path;
# auto: Jev judgments enter planning, with calibrated templates required before
# automatic semantic draft changes. Missing calibration always delegates to Parent.
TYPESAFE_API_KEY=
TRAVEL_AGENT_JEV_MODE=off
TRAVEL_AGENT_JEV_CALIBRATION_FILE=
# Jev limits are fixed in code across this deployment/account: 1080 normal RPM,
# 60 retry RPM, 60 unused headroom, 1200 hard rolling RPM and 250000 input TPS.
# Parent/Child limits still require the actual provider account entitlements.
TRAVEL_AGENT_EXECUTION_ROLE=combined
TRAVEL_AGENT_WORKER_RUNS=16
TRAVEL_AGENT_MAX_ACTIVE_RUNS=32
TRAVEL_AGENT_MODEL_LIMITS=

# AMap Web Service for China POI, place photos and static maps
AMAP_API_KEY=
# Optional: fill only when digital signature is enabled for this Web Service Key.
AMAP_API_SECRET=
TRAVEL_AGENT_AMAP_SMOKE_STATUS=not_run

# AMap JavaScript API 2.0 renderer. This Web JS key is intentionally returned
# to authenticated Web clients; the security code stays server-side and is
# appended only by the fixed /_AMapService proxy.
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
TRAVEL_AGENT_AMAP_JS_RENDERER_ENABLED=true
TRAVEL_AGENT_AMAP_JS_SMOKE_STATUS=not_run

# Dedicated-account social read Worker. Keep disabled until account, terms,
# audit and isolated read-only smoke are all complete.
TRAVEL_AGENT_SOCIAL_WORKER_ENABLED=false
TRAVEL_AGENT_SOCIAL_WORKER_AUDIT_STATUS=not_run
TRAVEL_AGENT_SOCIAL_WORKER_TERMS_STATUS=not_reviewed
TRAVEL_AGENT_SOCIAL_WORKER_ACCOUNT_PROFILE=
TRAVEL_AGENT_SOCIAL_WORKER_SMOKE_STATUS=not_run

# Weather fallback. Free/no-key mode is for non-commercial local evaluation only.
# Production requires a paid Open-Meteo customer API key or a passed AMap weather smoke.
TRAVEL_AGENT_OPEN_METEO_ENABLED=true
OPEN_METEO_API_KEY=

# Fliggy FlyAI: hotel, flight, train and POI search with Fliggy handoff links.
# The official MCP endpoint is fixed inside the audited CLI: https://flyai.open.fliggy.com/mcp
# Keep disabled until npm package version/SHA and read-only isolated smoke are audited.
TRAVEL_AGENT_FLYAI_ENABLED=false
FLYAI_API_KEY=
TRAVEL_AGENT_FLYAI_SMOKE_STATUS=not_run

# Tuniu official MCP: second-source train, hotel, flight and ticket search.
# Fixed endpoints: https://openapi.tuniu.cn/mcp/{train,hotel,flight,ticket}
# Apply at https://open.tuniu.com/mcp and enable only after a real read-only smoke.
TRAVEL_AGENT_TUNIU_ENABLED=false
TUNIU_API_KEY=
TRAVEL_AGENT_TUNIU_SMOKE_STATUS=not_run

# Public Web/Capacitor API address. Leave blank for same-origin Web/PWA.
# This is an address only; never put a secret in a VITE_* variable.
VITE_TRAVEL_API_BASE_URL=

# Optional public browser tile template and required attribution for the map workspace.
# Never place AMAP_API_KEY or any server credential here. When blank, local development
# uses attributed OpenStreetMap tiles; production falls back to the server AMap static map.
VITE_TRAVEL_MAP_TILE_URL=
VITE_TRAVEL_MAP_ATTRIBUTION=
