.page {
  min-height:100vh;
  padding-bottom:160rpx;
  color:#172126;
  background:#f3f6f7;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button::after { border:0; }
.header {
  min-height:104rpx;
  padding:28rpx 28rpx 20rpx;
  position:sticky;
  top:0;
  z-index:8;
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1rpx solid #e2e7e9;
  background:rgba(255,255,255,.97);
}
.brand-lockup { display:grid; gap:2rpx; }
.brand { font-size:32rpx; font-weight:800; letter-spacing:-1rpx; }
.brand-sub { color:#7b878d; font-size:19rpx; font-weight:600; }
.locale-pill {
  padding:10rpx 16rpx;
  border:1rpx solid #d9e0e3;
  border-radius:999rpx;
  color:#50626c;
  background:#f8fafb;
  font-size:21rpx;
  font-weight:700;
}
.welcome { padding:64rpx 34rpx 36rpx; background:#fff; }
.welcome-kicker,.section-eyebrow {
  display:block;
  color:#c9473e;
  font-size:20rpx;
  font-weight:800;
  letter-spacing:2rpx;
}
.title { display:block; margin-top:14rpx; font-size:54rpx; line-height:1.15; font-weight:800; letter-spacing:-2rpx; }
.copy { display:block; margin-top:10rpx; color:#617079; font-size:24rpx; line-height:1.65; }
.welcome-flow { margin-top:34rpx; display:flex; align-items:center; gap:12rpx; color:#445760; font-size:21rpx; font-weight:700; }
.flow-line { height:2rpx; flex:1; background:#dbe3e6; }
.card,.plan,.trip-hero {
  margin:22rpx 22rpx 0;
  padding:26rpx;
  border:1rpx solid #dfe5e8;
  border-radius:24rpx;
  background:#fff;
  box-shadow:0 8rpx 26rpx rgba(31,48,57,.05);
}
.sign-in-card { margin-top:24rpx; }
.card-title { display:block; font-size:31rpx; line-height:1.3; font-weight:800; letter-spacing:-1rpx; }
.primary {
  min-height:84rpx;
  margin-top:24rpx;
  border-radius:17rpx;
  color:#fff;
  background:#d95046;
  font-size:26rpx;
  font-weight:800;
}
.trip-context {
  margin:18rpx 22rpx 0;
  padding:18rpx 20rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18rpx;
  border:1rpx solid #dbe3e6;
  border-radius:18rpx;
  background:#fff;
}
.trip-context>view { min-width:0; display:grid; gap:2rpx; }
.trip-context-label { color:#c9473e; font-size:18rpx; font-weight:800; }
.trip-context-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:27rpx; font-weight:800; }
.trip-context-meta { flex:none; color:#65747c; font-size:21rpx; }
.conversation-workspace { padding-bottom:210rpx; }
.chat-head { padding:34rpx 28rpx 18rpx; }
.chat-head .card-title { margin-top:7rpx; }
.messages {
  height:calc(100vh - 510rpx);
  min-height:420rpx;
  padding:0 22rpx 28rpx;
  box-sizing:border-box;
}
.conversation-empty {
  margin-top:14rpx;
  padding:30rpx 24rpx;
  border:1rpx solid #dfe6e9;
  border-radius:22rpx;
  background:#fff;
}
.empty-title { display:block; font-size:29rpx; font-weight:800; }
.starter-prompts { margin-top:22rpx; display:grid; gap:12rpx; }
.starter-prompts button {
  min-height:90rpx;
  margin:0;
  padding:14rpx 16rpx;
  display:grid;
  align-content:center;
  gap:3rpx;
  border:1rpx solid #dce4e7;
  border-radius:16rpx;
  color:#304650;
  background:#f7fafb;
  text-align:left;
  line-height:1.35;
}
.starter-prompts button text:first-child { font-size:24rpx; font-weight:800; }
.starter-prompts button text:last-child { color:#6b7a82; font-size:20rpx; }
.message {
  max-width:86%;
  margin:14rpx 0;
  padding:20rpx 22rpx;
  border:1rpx solid #e5eaec;
  border-radius:7rpx 22rpx 22rpx;
  color:#26343a;
  background:#fff;
  font-size:27rpx;
  line-height:1.62;
}
.message.user { margin-left:auto; color:#fff; border-color:#263b4d; border-radius:22rpx 7rpx 22rpx 22rpx; background:#263b4d; }
.message.status { color:#75440f; border-color:#eed8bd; background:#fff7ed; }
.composer {
  padding:18rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  position:fixed;
  right:0;
  bottom:112rpx;
  left:0;
  z-index:9;
  display:grid;
  gap:12rpx;
  border-top:1rpx solid #dfe5e7;
  background:rgba(255,255,255,.98);
}
.composer textarea {
  min-height:82rpx;
  max-height:210rpx;
  padding:15rpx 17rpx;
  border:1rpx solid #cbd5d9;
  border-radius:17rpx;
  background:#fff;
  font-size:26rpx;
}
.composer-actions { display:flex; align-items:center; justify-content:space-between; gap:14rpx; }
.composer-hint { color:#728087; font-size:20rpx; }
.send { width:128rpx; height:66rpx; line-height:66rpx; margin:0; border-radius:15rpx; color:#fff; background:#d95046; font-size:24rpx; font-weight:800; }
.itinerary-workspace,.map-workspace { padding-bottom:18rpx; }
.trip-hero { padding:28rpx; color:#fff; border-color:#263b4d; background:#263b4d; }
.trip-hero .section-eyebrow { color:#ffb0a9; }
.trip-hero-title { display:block; margin-top:8rpx; font-size:44rpx; font-weight:800; }
.trip-hero .copy { color:#d9e2e6; }
.trip-facts,.route-facts,.route-facilities { margin-top:15rpx; display:flex; flex-wrap:wrap; gap:9rpx; }
.trip-facts text,.route-facts text,.route-facilities text {
  padding:8rpx 12rpx;
  border-radius:999rpx;
  color:#425760;
  background:#edf3f5;
  font-size:20rpx;
}
.trip-hero .trip-facts text { color:#f5f8f9; background:#3b5263; }
.traveler-care { margin-top:22rpx; padding-top:18rpx; border-top:1rpx solid rgba(255,255,255,.2); }
.section-label { display:block; color:#8d514b; font-size:21rpx; font-weight:800; }
.trip-hero .section-label { color:#ffb0a9; }
.traveler-care>view { margin-top:11rpx; display:grid; gap:4rpx; }
.traveler-care>view text:first-child { font-size:23rpx; font-weight:800; }
.traveler-care>view text:last-child { color:#d9e2e6; font-size:21rpx; line-height:1.5; }
.plan-heading,.map-heading,.candidate-title-row {
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16rpx;
}
.plan-heading>view { min-width:0; display:grid; gap:6rpx; }
.evidence-chip,.map-evidence {
  flex:none;
  padding:8rpx 11rpx;
  border-radius:999rpx;
  color:#326149;
  background:#e9f5ed;
  font-size:18rpx;
  font-weight:800;
}
.budget-board { background:#f9fbfb; }
.budget-rows { margin-top:16rpx; }
.budget-rows>view {
  min-height:62rpx;
  display:grid;
  grid-template-columns:50rpx 120rpx minmax(0,1fr);
  align-items:center;
  gap:12rpx;
  border-top:1rpx solid #e1e7e9;
  font-size:22rpx;
}
.budget-rows text:first-child,.budget-rows text:nth-child(2) { font-weight:800; }
.budget-rows text:nth-child(2) { text-align:right; }
.budget-rows text:last-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#748188; font-size:19rpx; }
.decision-tabs {
  width:100%;
  margin-top:22rpx;
  white-space:nowrap;
}
.decision-tabs button {
  width:136rpx;
  min-height:82rpx;
  margin:0 9rpx 0 0;
  padding:10rpx 8rpx;
  display:inline-grid;
  align-content:center;
  border:1rpx solid #dce4e7;
  border-radius:16rpx;
  color:#63737b;
  background:#f5f8f9;
  font-size:24rpx;
  font-weight:800;
  line-height:1.2;
}
.decision-tabs button.active { color:#245e43; border-color:#92c1a2; background:#edf7f0; }
.decision-tabs button text { margin-top:4rpx; font-size:17rpx; font-weight:600; }
.domain { margin-top:20rpx; }
.candidate {
  margin-top:13rpx;
  padding:14rpx;
  display:flex;
  gap:15rpx;
  border:1rpx solid #dfe5e8;
  border-radius:19rpx;
  background:#fff;
}
.candidate.selected { border-color:#6fa783; box-shadow:0 0 0 2rpx #dceee2 inset; background:#f4faf6; }
.candidate image { width:148rpx; height:126rpx; flex:none; border-radius:14rpx; background:#e8edef; }
.candidate-body { min-width:0; flex:1; display:grid; align-content:start; gap:5rpx; }
.candidate-title-row>text:first-child { min-width:0; font-size:25rpx; line-height:1.35; font-weight:800; }
.candidate-choice { flex:none; color:#6b7c84; font-size:17rpx; font-weight:700; }
.candidate.selected .candidate-choice { color:#2f704c; }
.candidate-price { display:flex; align-items:baseline; gap:9rpx; }
.candidate-price text:first-child { color:#1d292e; font-size:25rpx; font-weight:800; }
.candidate-price text:last-child { color:#758289; font-size:18rpx; }
.candidate-price.reference text:first-child { color:#795c31; }
.candidate-price.estimate text:first-child { color:#2366a8; }
.candidate-copy,.facility-copy { display:block; color:#64737a; font-size:21rpx; line-height:1.5; }
.facility-copy { color:#316449; }
.candidate-actions { margin-top:10rpx; display:grid; grid-template-columns:1fr 1fr; gap:10rpx; }
.candidate-actions button {
  min-height:60rpx;
  margin:0;
  padding:0 12rpx;
  border:1rpx solid #d8e2e6;
  border-radius:14rpx;
  color:#52656e;
  background:#f7fafb;
  font-size:21rpx;
  font-weight:800;
  line-height:60rpx;
}
.candidate-actions .candidate-trial { color:#fff; border-color:#d95046; background:#d95046; }
.confirm-selection { width:100%; }
.accepted { padding:19rpx 0; border-bottom:1rpx solid #e4e9eb; }
.accepted>text:nth-child(2) { display:block; font-size:25rpx; font-weight:800; }
.schedule-label { display:block; margin-bottom:5rpx; color:#6b7d86; font-size:19rpx; font-weight:800; }
.map-cta { min-height:80rpx; margin-top:20rpx; border:1rpx solid #afc9d5; border-radius:16rpx; color:#315f77; background:#eef7fb; font-size:23rpx; font-weight:800; }
.map-heading { margin:26rpx 24rpx 16rpx; align-items:center; }
.map-heading .card-title { margin-top:5rpx; }
.map-evidence { color:#536b78; background:#e9f0f3; }
.route-day-tabs { width:calc(100% - 48rpx); margin:0 24rpx 12rpx; white-space:nowrap; }
.route-day-tabs button {
  min-width:112rpx;
  height:62rpx;
  line-height:62rpx;
  margin:0 9rpx 0 0;
  padding:0 16rpx;
  display:inline-block;
  border:1rpx solid #d7e0e5;
  border-radius:15rpx;
  color:#596a73;
  background:#fff;
  font-size:21rpx;
  font-weight:800;
}
.route-day-tabs button.active { color:#fff; border-color:#276798; background:#276798; }
.map { width:calc(100% - 44rpx); height:470rpx; margin:0 22rpx; border-radius:24rpx; overflow:hidden; }
.map-empty {
  height:360rpx;
  margin:0 22rpx;
  display:grid;
  align-content:center;
  justify-content:center;
  gap:10rpx;
  padding:28rpx;
  border:1rpx dashed #c8d4d9;
  border-radius:24rpx;
  color:#66777f;
  background:#eaf0f2;
  text-align:center;
  font-size:21rpx;
}
.map-empty text:first-child { color:#344a54; font-size:28rpx; font-weight:800; }
.route-sheet {
  margin:-34rpx 22rpx 0;
  padding:0 24rpx 26rpx;
  position:relative;
  z-index:3;
  border:1rpx solid #dce3e6;
  border-radius:26rpx 26rpx 22rpx 22rpx;
  background:#fff;
  box-shadow:0 -10rpx 30rpx rgba(28,46,55,.12);
}
.sheet-grip {
  width:100%;
  min-height:64rpx;
  margin:0;
  padding:7rpx 0 5rpx;
  display:grid;
  align-content:center;
  justify-content:center;
  gap:5rpx;
  border:0;
  color:#708087;
  background:transparent;
  font-size:18rpx;
  line-height:1.2;
}
.grip-line { width:68rpx; height:7rpx; margin:auto; border-radius:999rpx; background:#cbd4d8; }
.next-route .section-label { margin-top:4rpx; }
.route-title { display:block; margin-top:7rpx; font-size:29rpx; line-height:1.35; font-weight:800; }
.route-mode-options { margin-top:19rpx; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9rpx; }
.route-mode-options button {
  min-width:0;
  min-height:92rpx;
  margin:0;
  padding:10rpx 5rpx;
  display:grid;
  align-content:center;
  gap:4rpx;
  border:1rpx solid #d9e1e5;
  border-radius:14rpx;
  color:#56656d;
  background:#fff;
  font-size:21rpx;
  line-height:1.25;
}
.route-mode-options button.active { color:#215f3f; border-color:#8bc2a1; background:#eef8f1; }
.route-mode-options button text:last-child { color:#718087; font-size:17rpx; }
.route-steps,.day-route-list,.facility-panel { margin-top:22rpx; padding-top:20rpx; border-top:1rpx solid #e3e8ea; }
.route-steps { display:grid; gap:10rpx; }
.route-steps>text:not(.section-label) { color:#4f6069; font-size:21rpx; line-height:1.5; }
.route-warning { display:block; margin-top:15rpx; padding:14rpx; border-radius:12rpx; color:#7b4818; background:#fff4e7; font-size:20rpx; line-height:1.5; }
.day-route-list button {
  width:100%;
  min-height:78rpx;
  margin:10rpx 0 0;
  padding:12rpx 14rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  border:1rpx solid #dfe6e9;
  border-radius:14rpx;
  color:#40515b;
  background:#fff;
  font-size:20rpx;
  text-align:left;
}
.day-route-list button.active { color:#205b76; border-color:#91b8ca; background:#eef7fb; }
.day-route-list button text:first-child { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:800; }
.day-route-list button text:last-child { flex:none; color:#6e7c84; }
.map-source-note { display:block; margin-top:18rpx; color:#6d7a82; font-size:19rpx; line-height:1.5; }
.preview-backdrop {
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  left:0;
  z-index:18;
  background:rgba(20,31,38,.32);
}
.place-preview-sheet {
  max-height:82vh;
  padding:0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  position:fixed;
  right:0;
  bottom:0;
  left:0;
  z-index:19;
  overflow:auto;
  border-radius:34rpx 34rpx 0 0;
  background:#fff;
  box-shadow:0 -18rpx 44rpx rgba(16,31,39,.18);
}
.sheet-grip.static { min-height:46rpx; pointer-events:none; }
.place-preview-hero { display:grid; gap:18rpx; }
.place-preview-hero image,.place-preview-photo-empty {
  width:100%;
  height:290rpx;
  border-radius:24rpx;
  background:#e8eef1;
}
.place-preview-photo-empty {
  display:grid;
  place-items:center;
  color:#6a7981;
  font-size:22rpx;
  font-weight:800;
}
.place-preview-title { display:block; margin-top:8rpx; font-size:38rpx; line-height:1.22; font-weight:900; letter-spacing:-1rpx; }
.place-preview-facts,.place-preview-route,.place-preview-unknowns { margin-top:22rpx; padding:20rpx; display:grid; gap:12rpx; border:1rpx solid #dfe6e9; border-radius:20rpx; background:#f8fafb; }
.place-preview-facts>view { display:grid; gap:4rpx; }
.place-preview-facts>view text:first-child { color:#8d514b; font-size:20rpx; font-weight:800; }
.place-preview-facts>view text:last-child,.place-preview-route>text:not(.section-label),.place-preview-unknowns>text:not(.section-label) { color:#4e6069; font-size:22rpx; line-height:1.5; }
.place-preview-route { background:#f1f7fb; }
.place-preview-unknowns { border-color:#efd9b6; background:#fff8ed; }
.place-preview-actions { margin-top:22rpx; display:grid; grid-template-columns:1fr 1fr; gap:12rpx; }
.place-preview-actions button { margin:0; }
.secondary {
  min-height:84rpx;
  border:1rpx solid #d9e1e5;
  border-radius:17rpx;
  color:#50636c;
  background:#fff;
  font-size:26rpx;
  font-weight:800;
}
.workspace-tabs.bottom-tabs {
  height:112rpx;
  padding:0 16rpx env(safe-area-inset-bottom);
  position:fixed;
  right:0;
  bottom:0;
  left:0;
  z-index:10;
  display:flex;
  gap:0;
  border-top:1rpx solid #dfe4e7;
  background:#fff;
}
.workspace-tabs.bottom-tabs button {
  height:112rpx;
  margin:0;
  padding:10rpx 0 8rpx;
  flex:1;
  position:relative;
  display:grid;
  align-content:center;
  justify-content:center;
  gap:2rpx;
  border:0;
  border-radius:0;
  color:#617079;
  background:#fff;
  font-size:20rpx;
  font-weight:700;
  line-height:1.15;
}
.workspace-tabs.bottom-tabs button.active { color:#c9443b; }
.workspace-tabs.bottom-tabs button[disabled] { opacity:.4; }
.tab-symbol {
  width:42rpx;
  height:42rpx;
  margin:auto;
  display:grid;
  align-content:center;
  justify-content:center;
  border-radius:13rpx;
  color:#5f7179;
  background:#edf2f4;
  font-size:20rpx;
  font-weight:800;
}
.bottom-tabs button.active .tab-symbol { color:#fff; background:#d95046; }
.tab-badge {
  min-width:28rpx;
  height:28rpx;
  padding:0 6rpx;
  position:absolute;
  top:7rpx;
  left:calc(50% + 18rpx);
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:999rpx;
  color:#fff;
  background:#263b4d;
  font-size:17rpx;
  line-height:28rpx;
}
.notice.bottom {
  max-width:calc(100% - 44rpx);
  padding:13rpx 16rpx;
  position:fixed;
  right:22rpx;
  bottom:128rpx;
  left:22rpx;
  z-index:12;
  border:1rpx solid #e5c4a8;
  border-radius:14rpx;
  color:#74491f;
  background:rgba(255,247,237,.98);
  box-shadow:0 8rpx 24rpx rgba(54,39,25,.1);
  font-size:20rpx;
  line-height:1.5;
}

/* Connected journey layout; fixed docks no longer cover messages or notices. */
.journey-mini { box-sizing:border-box; height:100vh; min-height:0; display:flex; flex-direction:column; overflow:hidden; padding-bottom:calc(112rpx + env(safe-area-inset-bottom)); background:#f5f4ef; color:#243830; }
.journey-mini.journey-start { padding-bottom:env(safe-area-inset-bottom); }
.journey-mini.needs-login { overflow:auto; }
.journey-mini .header { position:relative; flex:none; min-height:64px; padding:12px 20px; background:#fffefa; border-color:#e0e5de; }
.journey-mini .brand { font-size:18px; font-weight:700; }
.journey-mini .brand-sub { font-size:12px; color:#617066; }
.journey-mini .history-toggle { min-height:44px; margin:0; padding:10px 14px; border:1px solid #d6dfd3; border-radius:10px; background:#f7faf4; font-size:13px; line-height:24px; color:#3e5c49; }
.journey-mini .welcome { flex:none; padding:36px 24px 24px; background:transparent; }
.journey-mini .welcome-kicker, .journey-mini .section-eyebrow { color:#52705e; font-size:12px; line-height:1.6; letter-spacing:1px; }
.journey-mini .title { margin-top:14px; font-size:34px; line-height:1.3; letter-spacing:-1px; font-weight:650; }
.journey-mini .copy { font-size:14px; line-height:1.8; color:#5d6b63; }
.journey-mini .welcome-flow { font-size:12px; color:#5d6b63; }
.journey-mini .sign-in-card { flex:none; margin:0 20px 24px; padding:24px; border-color:#dbe2d6; border-radius:20px; background:#fffefa; }
.journey-mini .card-title { font-size:21px; line-height:1.5; font-weight:650; }
.journey-mini .primary, .journey-mini .secondary, .journey-mini .map-cta { min-height:48px; box-sizing:border-box; padding:12px 16px; line-height:24px; font-size:15px; font-weight:650; border-radius:12px; }
.journey-mini .primary, .journey-mini .send, .journey-mini .candidate-actions .candidate-trial { background:#ad4935; border-color:#ad4935; }
.journey-mini button[disabled] { opacity:.48; }
.journey-mini .trip-context { flex:none; margin:12px 16px 0; padding:14px 16px; border-color:#dbe2d6; border-radius:14px; }
.journey-mini .trip-context-title { font-size:17px; }
.journey-mini .trip-context-label, .journey-mini .trip-context-meta { font-size:12px; line-height:1.6; }
.journey-mini .trip-context-meta { flex:1; text-align:right; }
.journey-mini .conversation-workspace { display:flex; flex-direction:column; flex:1; min-height:0; padding:0; }
