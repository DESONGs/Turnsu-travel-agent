.journey-mini .notice.bottom { position:static; flex:none; display:flex; align-items:center; gap:8px; max-width:none; margin:8px 16px; padding:8px 12px; font-size:13px; line-height:1.6; box-shadow:none; }
.journey-mini .notice.bottom text { flex:1; min-width:0; }
