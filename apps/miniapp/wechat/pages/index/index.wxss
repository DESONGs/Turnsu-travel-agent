.journey-mini .place-preview-sheet, .journey-mini .history-sheet { height:82vh; max-height:82vh; box-sizing:border-box; padding:0 20px calc(24px + env(safe-area-inset-bottom)); background:#fffefa; }
.journey-mini .place-preview-title { font-size:27px; line-height:1.4; font-weight:650; }
