.journey-mini .place-preview-actions { position:sticky; bottom:0; padding:12px 0; background:#fffefa; grid-template-columns:1fr; }
.journey-mini .history-sheet { position:fixed; z-index:19; right:0; left:0; bottom:0; border-radius:24px 24px 0 0; }
.journey-mini .history-row { width:100%; min-height:68px; margin:12px 0 0; padding:14px; display:flex; flex-direction:column; gap:6px; text-align:left; border-radius:12px; border:1px solid #dfe5da; background:#fff; color:#354d3e; line-height:1.6; }
