.execution-progress { margin: 12rpx 0; padding: 20rpx; border: 1rpx solid #dfe2ed; border-radius: 20rpx; background: #fff; font-size: 24rpx; color: #263047; }
.execution-heading, .execution-actions { display: flex; gap: 16rpx; align-items: center; justify-content: space-between; }
