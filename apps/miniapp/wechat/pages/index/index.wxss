.journey-mini .decision-tabs button.active { color:#315a40; border-color:#8aa78b; background:#edf5e7; }
.journey-mini .candidate { display:block; padding:0; margin-top:18px; border-radius:16px; overflow:hidden; border-color:#dce4d5; }
