.journey-mini .bottom-tabs button.active { color:#315a40; }
.journey-mini .bottom-tabs button.active .tab-symbol { background:#446c50; }

/* Trip Atlas: native task hierarchy, not a squeezed desktop canvas. */
.atlas-mini { background:#f8f9fd; color:#172039; }
