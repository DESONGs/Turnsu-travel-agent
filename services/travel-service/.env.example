# Java service configuration reference; export values into the service process.
# Keep actual secrets outside Git. No Google or travel source is enabled here.
TRAVEL_BIND_ADDRESS=127.0.0.1
TRAVEL_PORT=8798
TRAVEL_PUBLIC_ORIGIN=
TRAVEL_DATABASE_URL=
TRAVEL_DATABASE_USER=
TRAVEL_DATABASE_PASSWORD=
TRAVEL_DATABASE_POOL_SIZE=16
TRAVEL_GOOGLE_CLIENT_ID=
TRAVEL_GOOGLE_CLIENT_SECRET=
TRAVEL_MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
TRAVEL_MCP_ALLOWED_ORIGINS=https://chatgpt.com
TRAVEL_MCP_ALLOWED_HOSTS=
# Append the exact loopback callback and listener port selected for Codex.
TRAVEL_FOLLOW_UP_SCHEDULER_ENABLED=true
TRAVEL_AMAP_WEATHER_ENABLED=false
TRAVEL_AMAP_PLACES_ENABLED=false
TRAVEL_AMAP_WALKING_ENABLED=false
TRAVEL_AMAP_API_KEY=
TRAVEL_AMAP_API_SECRET=
TRAVEL_CIRIUM_STATUS_ENABLED=false
TRAVEL_CIRIUM_APP_ID=
TRAVEL_CIRIUM_APP_KEY=
TRAVEL_BACKGROUND_WORKER_ENABLED=false
TRAVEL_WORKER_TOKEN=
