{
  "name": "zhuanshu-travel-agent",
  "version": "0.1.0",
  "description": "Type-safe Pi runtime, contracts, providers, and MCP boundaries for Zhuanshu Travel Agent.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.19.0" },
  "pi": {
    "extensions": [
      "./extensions/host-compatibility.mjs",
      "./extensions/capability-registry.ts",
      "./extensions/model-routing.ts",
      "./extensions/travel-business-runtime.ts",
      "./extensions/subagents-runtime.ts"
    ],
    "skills": [
      "../plugins/travel-agent/skills/understand-trip",
      "../plugins/travel-agent/skills/research-trip",
      "../plugins/travel-agent/skills/plan-trip",
      "../plugins/travel-agent/skills/recover-trip",
      "../node_modules/pi-subagents/skills"
    ],
    "subagents": { "agents": ["./agents"] }
  },
  "pi-subagents": { "agents": ["./agents"] },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/generate-schemas.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "dependencies": {
    "@quintinshaw/pi-dynamic-workflows": "3.5.1",
    "jiti": "2.7.0",
    "pi-subagents": "0.46.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
